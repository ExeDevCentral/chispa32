# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Telegram Bot (Para recibir alertas instantáneas en tu celular)
# 1. Creá un bot con @BotFather en Telegram y obtené el Token
TELEGRAM_BOT_TOKEN=
# 2. Obtené tu Chat ID enviando un mensaje a @userinfobot en Telegram
TELEGRAM_CHAT_ID=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
